# ── SEO 404 Fix — Phase 23E (2026-06-24) ─────────────────────────────────────
# Redirect clean URLs → .html files (Apache DirectoryIndex doesn't handle these)
Options +FollowSymlinks
RewriteEngine On

# Shortlinks / QR destinations
RewriteRule ^go/([^/?#]+)/?$ /api/public/shortlinks/$1 [QSA,L]

# Clean URL rewrites — /about → /about.html
RewriteRule ^about/?$         /about.html         [R=301,L]
RewriteRule ^privacy/?$       /privacy.html       [R=301,L]
RewriteRule ^privacy-policy/?$ /privacy.html      [R=301,L]
RewriteRule ^terms/?$         /terms.html         [R=301,L]
RewriteRule ^terms-of-service/?$ /terms.html      [R=301,L]
RewriteRule ^happy-hour/?$    /happy-hour.html    [R=301,L]
RewriteRule ^menu/?$          /menu.html          [R=301,L]
RewriteRule ^blog/?$          /blog.html          [R=301,L]

# Broth Log dashboard — one manager-facing URL. Stores are selected inside the dashboard.
RewriteRule ^broth-log-b[123](\.html)?/?$ - [R=404,L]
RewriteCond %{THE_REQUEST} \s/+broth-log\.html[\s?]
RewriteRule ^broth-log\.html$ /broth-log [R=301,L]
RewriteRule ^broth-log/?$ /broth-log.html [L]

# Broth Log contains internal food-safety data (employee names, live compliance
# readings) and its JS pulls from Google Sheets by ID -- gate every asset the
# dashboard needs, not just the HTML page, so an unauthenticated request never
# reaches the Sheet IDs. Same AuthName on all three so the browser reuses one
# prompt. Credentials in .htpasswd-broth-log (bcrypt, not committed in plaintext).
<Files "broth-log.html">
    AuthType Basic
    AuthName "Bakudan Staff - Broth Log"
    AuthUserFile /home/hoale24new/bakudanramen.com/.htpasswd-broth-log
    Require valid-user
</Files>
<Files "broth-log-dashboard.js">
    AuthType Basic
    AuthName "Bakudan Staff - Broth Log"
    AuthUserFile /home/hoale24new/bakudanramen.com/.htpasswd-broth-log
    Require valid-user
</Files>
<Files "broth-log.css">
    AuthType Basic
    AuthName "Bakudan Staff - Broth Log"
    AuthUserFile /home/hoale24new/bakudanramen.com/.htpasswd-broth-log
    Require valid-user
</Files>

# Missing pages — redirect to nearest equivalent
RewriteRule ^gift-cards?/?$   /order              [R=301,L]
RewriteRule ^loyalty/?$       /order              [R=301,L]
RewriteRule ^drinks/?$        /menu.html          [R=301,L]

# Legacy WordPress-hack spam-injection URLs (?k=...&mod=...&uri=*.php) are stale
# in Google's index from a prior, now-decommissioned WordPress instance -- no
# WordPress files exist on this server. The query string alone doesn't change
# which file gets served, so these were quietly 200-ing to the homepage (a soft
# 404 signal to search engines). Hard 410 instead, so the index entries drop.
RewriteCond %{QUERY_STRING} (^|&)mod=[0-9a-f]+(&|$)
RewriteCond %{QUERY_STRING} (^|&)uri=[a-z0-9_-]+\.php
RewriteRule ^$ - [G,L]

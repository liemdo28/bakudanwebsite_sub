# Copy this file to .env and fill in values
PORT=5181

# Broth Log Telegram alerts. Use real values only in hosting env vars.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-new-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
BROTH_LOG_TELEGRAM_ALERT_ENDPOINT=https://bakudanramen.com/api/broth-log/telegram/alerts
